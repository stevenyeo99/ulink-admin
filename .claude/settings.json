{
  "permissions": {
    "defaultMode": "plan"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/render-api-flowchart.sh",
            "timeout": 90,
            "statusMessage": "Rendering the API case flowchart SVG"
          }
        ]
      }
    ]
  }
}

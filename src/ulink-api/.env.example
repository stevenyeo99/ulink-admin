NODE_ENV=development
PORT=3088
LOG_LEVEL=debug
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

#freshdesk
FRESHDESK_API_KEY=your_freshdesk_api_key

# Supabase DB (direct Postgres connection, not the Supabase SDK)
SUPABASE_DB_ENABLED=true
SUPABASE_DB_CONN_STR=postgresql://user:password@host:5432/postgres
SUPABASE_DB_SSL=true
SUPABASE_DB_POOL_MAX=10
SUPABASE_DB_POOL_MIN=0
SUPABASE_DB_POOL_IDLE_MS=30000
SUPABASE_DB_POOL_ACQUIRE_MS=30000

# LM Studio local server
LLM_URL=http://localhost:1234
MODEL=your_vision_model_name
MODEL_ASSISTANT=your_text_model_name
# 'none' avoids a verified hang: this model's "thinking" pass can run unbounded on
# hard vision content (handwriting) and never converge, even with a large token budget.
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_MS=120000
LLM_MAX_IMAGES=6
LLM_MAX_REQUEST_BYTES=25000000

# Claim Recognition job (email-intake output -> route decision + OCR field extraction)
CLAIM_RECOGNITION_BATCH_LIMIT=5
CLAIM_RECOGNITION_CONFIDENCE_THRESHOLD=0.6
CLAIM_RECOGNITION_RASTER_DPI=100
CLAIM_RECOGNITION_MAX_TOKENS_PER_PAGE=800

# IMAP mailbox (Email Intake job)
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=your_mailbox_user
IMAP_PASSWORD=your_mailbox_app_password
IMAP_FOLDER=INBOX
IMAP_FETCH_LIMIT=20
IMAP_SOCKET_TIMEOUT_MS=30000
IMAP_CONNECTION_TIMEOUT_MS=30000
IMAP_GREETING_TIMEOUT_MS=15000

# Attachment storage adapter (Day 1: local only; s3/supabase reserved for later)
STORAGE_DRIVER=local
STORAGE_ROOT=./data/attachments

# Submission channel adapter (Day 1: imap_smtp; freshdesk reserved until API access is granted)
CHANNEL_DRIVER=imap_smtp

# Job-trigger endpoints (POST /api/jobs/<block>/run) are unauthenticated for Day 1 —
# trusted host/network assumption. Add a shared-secret header before external exposure.

#IAS
IAS_URL=https://tpa.staging.ins-link.com
GET_MEMBER_INFO_API=/api/get_member_info_by_policy
CL_PRE_APP_CLAIM_API=/api/claim_pre_approval
CL_CLAIM_API=/api/claim_submission
CL_CLAIM_STATUS_API=/api/get_claim_status
CL_DOWNLOAD_FILE_API=/api/download
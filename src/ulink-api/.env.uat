# ulink-api — UAT on the AWS server. Copied from the local .env on 2026-10-14; server-specific values changed:
# NODE_ENV, PORT, LOG_LEVEL, STORAGE_ROOT, CONSOLE_UPLOAD_ROOT, CSR_UPLOAD_ROOT, CONSOLE_URL, CONSOLE_MIDDLEWARE_URL.
# Installed on the server as /home/ulinkai/uat/ulink-api/.env (chmod 600). Git-ignored: contains secrets.
NODE_ENV=production
PORT=3088
LOG_LEVEL=info
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

#freshdesk
FRESHDESK_API_KEY=NpGqhvKsS64HJTqzzNO

# Supabase DB
SUPABASE_DB_ENABLED=true
# SUPABASE_DB_CONN_STR=postgresql://postgres.drqxpypivobkntudnahv:$uccesfullDrt888@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_CONN_STR=postgresql://postgres.genzlleggpegmbkemeoj:Dr.Av1-L0eb@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_SSL=true
SUPABASE_DB_POOL_MAX=1
SUPABASE_DB_POOL_MIN=0
SUPABASE_DB_POOL_IDLE_MS=10000
SUPABASE_DB_POOL_ACQUIRE_MS=30000

# LM Studio local server
LLM_URL=http://100.72.65.114:1234
MODEL=qwen/qwen3.6-35b-a3b
LLM_REASONING_EFFORT=none
DOCUMENT_CHECKING_REASONING_EFFORT=medium
# Bumped 2026-09-15 from 300000 (5 min) — real logs show single calls genuinely timing out
# at 5 min, and claim-recognition processes pages sequentially so a multi-page case can
# need several calls back to back.
LLM_TIMEOUT_MS=1800000
LLM_MAX_IMAGES=5
LLM_MAX_REQUEST_BYTES=52428800

# Backstop around one full pipeline step (e.g. claim-recognition's whole batch), separate
# from LLM_TIMEOUT_MS above (that's per LLM call). Bumped 2026-09-15 from the 300000 (5 min)
# code default — real logs show claim-recognition legitimately taking up to 23 minutes for
# just 2 cases when run standalone (no wrapper), so the 5-min backstop was killing healthy
# runs, not just genuine hangs.
PIPELINE_STEP_TIMEOUT_MS=1800000

# Embeddings (ICD-10 diagnosis RAG — modules/icd10/). Same LM Studio server as LLM_URL above.
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_TIMEOUT_MS=30000

# Claim Recognition job (email-intake output -> route decision + OCR field extraction)
CLAIM_RECOGNITION_BATCH_LIMIT=5
CLAIM_RECOGNITION_CONFIDENCE_THRESHOLD=0.6
CLAIM_RECOGNITION_RASTER_DPI=100
CLAIM_RECOGNITION_MAX_TOKENS_PER_PAGE=800

# IMAP mailbox (Email Intake job)
IMAP_HOST=mail.dynrtech.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=ulink.ias.claim@dynrtech.com
IMAP_PASSWORD=ul1nk.1as.cla1m
IMAP_FOLDER=INBOX
IMAP_FETCH_LIMIT=20
IMAP_SOCKET_TIMEOUT_MS=30000
IMAP_CONNECTION_TIMEOUT_MS=30000
IMAP_GREETING_TIMEOUT_MS=15000

# SMTP (Email Sender job — outbound replies via channels/imapSmtpChannel.js)
# Same mailbox as IMAP above — verify host/port/TLS against your mail provider's
# submission settings before relying on this; placeholder guess, not verified.
SMTP_HOST=mail.dynrtech.com
SMTP_PORT=587
SMTP_TLS=false
SMTP_USER=ulink.ias.claim@dynrtech.com
SMTP_PASSWORD=ul1nk.1as.cla1m
SMTP_FROM=ulink.ias.claim@dynrtech.com
SMTP_CONNECTION_TIMEOUT_MS=30000

# Email Sender job
EMAIL_SENDER_BATCH_LIMIT=20
EMAIL_SENDER_MAX_ATTEMPTS=5

# Internal ops inbox for member-verification's MEMBER_VERIFY_ISSUE notices (SOP §11: held
# for internal verification/escalation, never sent to the customer). Required for that
# EmailTask type to send at all — leaving it unset fails those tasks loudly.
INTERNAL_REVIEW_EMAIL=steven.yeo@dynrtech.com

# Member Verification job
MEMBER_VERIFICATION_BATCH_LIMIT=20


# IAS Claim Preparation job
IAS_CLAIM_PREPARATION_BATCH_LIMIT=20

# IAS Claim Creation job
IAS_CLAIM_CREATION_BATCH_LIMIT=20

# Attachment storage adapter (Day 1: local only; s3/supabase reserved for later)
STORAGE_DRIVER=local
STORAGE_ROOT=/home/ulinkai/uat/ulink-attachments/claims

# Dedicated shared folder the console/ops side browses directly — separate from
# STORAGE_ROOT above, which is this app's own private attachment store.
CONSOLE_UPLOAD_ROOT=/home/ulinkai/uat/ulink-attachments/console-upload

# API cases: console images downloaded as a zip from ulink-console-middleware, stored like
# email attachments (STORAGE_ROOT). Grace = how long after the IAS claim to wait for images.
CONSOLE_MIDDLEWARE_URL=https://tpa.api.ias.staging.ins-link.com/admin/_
API_MATERIAL_GRACE_MINUTES=120
API_MATERIAL_DOWNLOAD_BATCH_LIMIT=10

# API cases: customer emails go here until the IAS member-info email is used.
API_CASE_CUSTOMER_EMAIL=steven.yeo@dynrtech.com
API_EMAIL_BATCH_LIMIT=20

# Dedicated shared folder for downloaded CSR (Claim Settlement Report) PDFs. Path below is a
# placeholder guess (sibling of CONSOLE_UPLOAD_ROOT) — not explicitly confirmed, change if
# the real shared path differs.
CSR_UPLOAD_ROOT=/home/ulinkai/uat/ulink-attachments/csr

# Submission channel adapter (Day 1: imap_smtp; freshdesk reserved until API access is granted)
CHANNEL_DRIVER=imap_smtp

# Job-trigger endpoints (POST /api/jobs/<block>/run) are unauthenticated for Day 1 —
# trusted host/network assumption. Add a shared-secret header before external exposure.

#IAS
IAS_URL=https://tpa.staging.ins-link.com
GET_MEMBER_INFO_API=/api/get_member_info_by_policy
CL_PRE_APP_CLAIM_API=/api/claim_pre_approval
CL_CLAIM_API=/api/claim_submission
CL_CLAIM_REVISION_API=/api/claim_revision
CL_CLAIM_STATUS_API=/api/get_claim_status
CL_DOWNLOAD_FILE_API=/api/download
GET_CLAIM_API=/api/get_claim_api
IAS_TIMEOUT_MS=30000
# Signs console login tokens (8 hours). Keep secret; changing it logs everyone out.
JWT_SECRET=f865e0e03b2834732d52e22d395bff8ef1cccdc82705482c2c9492c316f837ef

# Console address for "Open this case" links in internal emails (no trailing slash). Unset = no link.
CONSOLE_URL=http://47.131.150.18:5173

# Console upload by API (cl-upload) — docs/imp/demo/API DAY1/CL-UPLOAD SPEC/console_upload_requirement.md
CONSOLE_UPLOAD_METHOD=cl-upload
CL_UPLOAD_URL=https://api.ulink.ins-link.com/cl-upload
CL_UPLOAD_API_KEY=01d3c3a1-bfcf-4cc7-8c8c-68229d98ad21
